# Supabase project (Project settings → API). The anon/publishable key is public:
# row-level security and the server functions decide what it can do.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public URL printed in QR labels (your Vercel deployment). Falls back to the current origin.
VITE_PUBLIC_URL=https://landed-nb.vercel.app

# Show the demo sign-in shortcuts (buyer, Marc, Lise) on the sign-in page.
VITE_DEMO_LOGINS=true

# ---- Server only (Vercel environment variables / .env.local). Never prefix with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
# Any long random string; used to hash device ids and network addresses for scans.
LABEL_HASH_SALT=change-me
